{
  "version": "uci350-v2.0",
  "seed": 42,
  "split": {"train": 18000, "validation": 4500, "calibration": 3000, "test": 4500},
  "selection_metric": "unweighted validation log loss",
  "minimum_validation_improvement_over_simpler": 0.001,
  "minimum_calibration_and_test_events_per_class": 100,
  "logistic_C": [0.1, 1, 10],
  "xgb_depth": [2, 4],
  "xgb_learning_rate": [0.03, 0.1],
  "xgb_rounds": 350,
  "xgb_patience": 20,
  "mlp_batch_size": [32, 64, 128],
  "mlp_hidden": [64, 32],
  "mlp_epochs": 40,
  "mlp_patience": 6,
  "mlp_learning_rate": 0.001,
  "mlp_weight_decay": 0.0001,
  "mlp_clip_norm": 5,
  "calibration": "sigmoid on clipped raw log odds",
  "bootstrap_replicates": 1000,
  "bootstrap_seed": 43,
  "paired_log_loss_comparisons": [["selected_raw", "dummy"], ["selected_raw", "logistic"], ["selected_calibrated", "selected_raw"]],
  "scope_gates": ["Demographics and IDs excluded from predictors", "Both classes present in all partitions", "Finite converged fits and validation losses", "Independent subgroup fairness review pending; no production eligibility"]
}
